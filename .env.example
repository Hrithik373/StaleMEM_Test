# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Judge (paper used Gemini-3.1-flash-lite via an OpenAI-compatible endpoint)
GEMINI_API_KEY=
# Hosted open-model provider (e.g. Together / OpenRouter / DeepInfra), for E2
OPEN_MODELS_API_KEY=
# Local vLLM server needs no key; set api_key_env to a var holding "EMPTY"
VLLM_API_KEY=EMPTY
